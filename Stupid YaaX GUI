local Players            = game:GetService("Players")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local TweenService       = game:GetService("TweenService")
local UserInputService   = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")

local LocalPlayer = Players.LocalPlayer

-- Safely get the player's character
local function getChar()
	return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

-- Safely get the F3X tool (SyncAPI)
local function getF3X()
	local char     = LocalPlayer.Character
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	local containers = { backpack, char }
	for _, c in ipairs(containers) do
		if c then
			for _, v in ipairs(c:GetChildren()) do
				if v:FindFirstChild("SyncAPI") then
					return v
				end
			end
		end
	end
	for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
		if v.Name == "SyncAPI" then
			return v.Parent
		end
	end
	return nil
end

-- Safely get the HD Admin remote (may not exist in every game)
local function getHDAdmin()
	local ok, client = pcall(function()
		return ReplicatedStorage:WaitForChild("HDAdminHDClient", 3)
	end)
	if not ok or not client then return nil end
	local ok2, signals = pcall(function()
		return client:WaitForChild("Signals", 3)
	end)
	if not ok2 or not signals then return nil end
	local ok3, remote = pcall(function()
		return signals:WaitForChild("RequestCommandSilent", 3)
	end)
	return ok3 and remote or nil
end

-- Fire an HD Admin command safely
local function hdCmd(cmd)
	local remote = getHDAdmin()
	if remote then
		pcall(function()
			remote:InvokeServer(cmd)
		end)
	end
end

--=====================================================================
-- F3X REMOTE WRAPPER
--=====================================================================
-- Creates a bundle of F3X functions bound to the player's SyncAPI.
-- Returns a table of functions, or nil if F3X is missing.
local function bindF3X()
	local tool = getF3X()
	if not tool then
		warn("[TeamArmedGUI] F3X tool not found — equip Building Tools first.")
		return nil
	end
	local syncapi = tool:FindFirstChild("SyncAPI")
	if not syncapi then return nil end
	local endpoint = syncapi:FindFirstChild("ServerEndpoint")
	if not endpoint then return nil end

	local function _(args)
		return endpoint:InvokeServer(unpack(args))
	end

	local F = {}
	F.raw = _

	function F.SetCollision(part, bool)
		_({ "SyncCollision", { { Part = part, CanCollide = bool } } })
	end
	function F.SetAnchor(part, bool)
		_({ "SyncAnchor", { { Part = part, Anchored = bool } } })
	end
	function F.CreatePart(cf, parent, kind)
		return _({ "CreatePart", kind or "Normal", cf, parent or workspace })
	end
	function F.DestroyPart(part)
		_({ "Remove", { part } })
	end
	function F.MovePart(part, cf)
		_({ "SyncMove", { { Part = part, CFrame = cf } } })
	end
	function F.Resize(part, size, cf)
		_({ "SyncResize", { { Part = part, CFrame = cf, Size = size } } })
	end
	function F.AddMesh(part)
		_({ "CreateMeshes", { { Part = part } } })
	end
	function F.SetMesh(part, id)
		_({ "SyncMesh", { { Part = part, MeshId = "rbxassetid://" .. tostring(id) } } })
	end
	function F.SetTexture(part, id)
		_({ "SyncMesh", { { Part = part, TextureId = "rbxassetid://" .. tostring(id) } } })
	end
	function F.SetName(part, name)
		_({ "SetName", { part }, name })
	end
	function F.MeshResize(part, scale)
		_({ "SyncMesh", { { Part = part, Scale = scale } } })
	end
	function F.Weld(part1, part2, lead)
		_({ "CreateWelds", { part1, part2 }, lead })
	end
	function F.SetLocked(part, bool)
		_({ "SetLocked", { part }, bool })
	end
	function F.SetTrans(part, n)
		_({ "SyncMaterial", { { Part = part, Transparency = n } } })
	end
	function F.Color(part, color)
		_({ "SyncColor", { { Part = part, Color = color, UnionColoring = false } } })
	end
	function F.CreateSpotlight(part)
		_({ "CreateLights", { { Part = part, LightType = "SpotLight" } } })
	end
	function F.CreatePointLight(part)
		_({ "CreateLights", { { Part = part, LightType = "PointLight" } } })
	end
	function F.SyncLighting(part, brightness)
		_({ "SyncLighting", { { Part = part, LightType = "SpotLight", Brightness = brightness } } })
	end
	function F.SyncPointLight(part, brightness, color)
		_({ "SyncLighting", { { Part = part, LightType = "PointLight", Brightness = brightness, Color = color } } })
	end
	function F.AddFire(part)
		_({ "CreateDecorations", { { Part = part, DecorationType = "Fire" } } })
	end
	function F.SyncFire(part, size, heat)
		_({ "SyncDecorate", { { Part = part, DecorationType = "Fire", Size = size, Heat = heat } } })
	end
	function F.SpawnDecal(part, side)
		_({ "CreateTextures", { { Part = part, Face = side, TextureType = "Decal" } } })
	end
	function F.AddDecal(part, asset, side)
		_({ "SyncTexture", { { Part = part, Face = side, TextureType = "Decal", Texture = "rbxassetid://" .. tostring(asset) } } })
	end
	function F.CreateTexture(part, side)
		_({ "CreateTextures", { { Part = part, Face = side, TextureType = "Texture" } } })
	end
	function F.SyncTexture(part, side, id, u, v)
		_({ "SyncTexture", { { Part = part, Face = side, TextureType = "Texture", Texture = "rbxassetid://" .. tostring(id), StudsPerTileU = u or 2, StudsPerTileV = v or 2 } } })
	end

	-- Convenience: create a skybox part high above the player and return it
	function F.CreateSky(textureId, scale)
		local char = getChar()
		local hrp  = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return nil end
		local pos  = hrp.CFrame.Position + Vector3.new(0, 6, 0)
		local part = F.CreatePart(CFrame.new(pos), workspace)
		if not part then return nil end
		F.SetName(part, "Sky")
		F.AddMesh(part)
		F.SetMesh(part, "111891702759441")
		F.SetTexture(part, textureId)
		F.MeshResize(part, scale or Vector3.new(7000, 7000, 7000))
		F.SetLocked(part, true)
		F.SetAnchor(part, true)
		F.SetCollision(part, false)
		return part
	end

	return F
end

