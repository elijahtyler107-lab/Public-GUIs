-- Creates a TextButton directly under the ScrollingFrame (instead of
-- the tiny TextLabel_4) so buttons are actually visible & clickable.
local nextY = 80

local function makeButton(name, text, callback, width, xOffset, yOffset)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Parent = ScrollingFrame
	btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	btn.BorderColor3 = Color3.fromRGB(0, 53, 11)
	btn.Size = UDim2.new(0, width or 180, 0, 36)
	btn.Position = UDim2.new(0, xOffset or 8, 0, yOffset or nextY)
	btn.Font = Enum.Font.SourceSans
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextScaled = true
	btn.TextWrapped = true
	btn.MouseButton1Click:Connect(function()
		local ok, err = pcall(callback)
		if not ok then
			warn("[TeamArmedGUI] " .. tostring(name) .. " error: " .. tostring(err))
		end
	end)
	return btn
end

