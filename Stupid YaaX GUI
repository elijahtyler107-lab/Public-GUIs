-- GAMEPASS PROMPTS (non-blocking, capped)
--=====================================================================
task.spawn(function()
	local GAMEPASS_1 = 1773241769
	local GAMEPASS_2 = 1772911838
	local current = GAMEPASS_1
	local attempts = 0

	local function owns(id)
		local ok, res = pcall(function()
			return MarketplaceService:UserOwnsGamepassAsync(LocalPlayer.UserId, id)
		end)
		return ok and res or false
	end

	task.wait(2)
	while attempts < 30 do
		attempts = attempts + 1
		if not owns(current) then
			pcall(function()
				MarketplaceService:PromptGamePassPurchase(LocalPlayer, current)
			end)
		else
			if current == GAMEPASS_1 then
				current = GAMEPASS_2
			else
				break
			end
		end
		task.wait(7)
	end
end)

